{
    "version": 1,
    "hooks": {
        "sessionStart": [
            {
                "type": "command",
                "command": "node .github/hooks/log-event.cjs sessionStart",
                "timeoutSec": 10
            }
        ],
        "userPromptSubmitted": [
            {
                "type": "command",
                "command": "node .github/hooks/log-event.cjs userPromptSubmitted",
                "timeoutSec": 10
            }
        ],
        "postToolUse": [
            {
                "type": "command",
                "command": "node .github/hooks/log-event.cjs postToolUse",
                "timeoutSec": 10
            },
            {
                "type": "command",
                "command": "node .github/hooks/validate-review.cjs",
                "timeoutSec": 10
            }
        ],
        "subagentStart": [
            {
                "type": "command",
                "command": "node .github/hooks/log-event.cjs subagentStart",
                "timeoutSec": 10
            }
        ],
        "subagentStop": [
            {
                "type": "command",
                "command": "node .github/hooks/log-event.cjs subagentStop",
                "timeoutSec": 10
            }
        ],
        "agentStop": [
            {
                "type": "command",
                "command": "node .github/hooks/log-event.cjs agentStop",
                "timeoutSec": 10
            }
        ],
        "sessionEnd": [
            {
                "type": "command",
                "command": "node .github/hooks/log-event.cjs sessionEnd",
                "timeoutSec": 10
            }
        ]
    }
}